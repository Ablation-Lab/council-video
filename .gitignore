# Dependencies
node_modules/

# Rendered output: videos, stills, review frames
out/
*.mp4
*.mov
*.webm
*.gif

# Remotion and bundler build artefacts
build/
dist/
.remotion/

# Temporary TTS narration (regenerate with `npm run narration`).
# manifest.json stays tracked so the project builds; the WAVs are large.
public/audio/*.wav

# Logs and editor/OS files
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local environment files
.env
.env.*

# Draft-build marker (temporary TTS in the narration)
public/audio/DRAFT.txt

# ElevenLabs line takes (the original scene takes, v3). Kept locally, not committed: they carry the
# voice vendor's C2PA metadata. The normalised clips in public/audio are tracked.
/scene[0-9][0-9]-*.mp3
/scene10[ab].mp3

# v4 restructure line takes (same reason as above)
/r4-*.mp3

# Two-part rebuild line takes, made with Eleven v4 (same reason as above)
/p1-*.mp3
/p2-*.mp3

# ElevenLabs API takes (scripts/tts.mjs): cache, manifest and replaced takes
/.tts-cache/
